2856.1 393.7 C 2858.9 397.1, 2862 400.2, 2863.1 400.5 C 2864.1 400.9, 2866.8 402.6, 2869 404.5 C 2877.3 411.4, 2892.9 411.7, 2902.1 405.2 C 2912.3 398, 2918.8 391.1, 2921 385.3 C 2922.1 382.3, 2923.9 378.2, 2924.9 376.1 C 2929.7 366.8, 2931.2 356.8, 2931.3 334.5 C 2931.4 309, 2929.5 298.1, 2922.5 283.2 C 2916.3 270.2, 2909.4 262.6, 2901.5 260.1 C 2893.7 257.7, 2884.8 256.9, 2878.5 258.1 M 1951.6 330.2 C 1950.7 331.4, 1949.1 335.2, 1948 338.6 C 1946.9 341.9, 1944.8 346.2, 1943.5 348 C 1941 351.4, 1940.2 357.2, 1941.8 359.7 C 1943.1 361.7, 1947.9 363, 1954.5 363 C 1961.1 363, 1965.9 361.7, 1967.2 359.7 C 1968.7 357.3, 1967.9 351.9, 1965.6 348.2 C 1964.2 346.2, 1962.4 341.8, 1961.5 338.5 C 1958.6 328.2, 1955.1 325.2, 1951.6 330.2';
  const TEXT_PATH_SCALE = 0.1;

  // Exact brand colors
  const ICON_COLOR = 0xfda84f; // iconic Zeus bolt gold/amber
  const TEXT_COLOR = 0xffffff; // pure white typography

  // Logo bounds in source pixels
  const SRC_CX = 156.5;
  const SRC_CY = 35.0;
  const LOGO_WORLD_WIDTH = 7.2;
  const PX = LOGO_WORLD_WIDTH / 283;

  type BrandRuntime = { dispose: () => void };
  let activeRuntime: BrandRuntime | undefined;

  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const easeOutCubic = (x: number) => 1 - Math.pow(1 - clamp(x, 0, 1), 3);
  const easeInOutCubic = (x: number) => {
    const t = clamp(x, 0, 1);
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  };
  const easeOutBack = (x: number) => {
    const t = clamp(x, 0, 1);
    const c1 = 1.4;
    const c3 = c1 + 1;
    return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
  };

  const toWorld = (x: number, y: number) =>
    new THREE.Vector2((x - SRC_CX) * PX, -(y - SRC_CY) * PX);

  const initLogoReveal3D = () => {
    const stage = document.getElementById('brand-3d-stage');
    const canvas = document.getElementById('brand-3d-canvas') as HTMLCanvasElement | null;
    const section = document.getElementById('brand');
    if (!stage || !canvas || !section) return;

    activeRuntime?.dispose();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;

    // -------------------------------------------------------------------------
    // TECHNIQUE 5: Zero Layout Thrashing (Cache Stage Rect)
    // -------------------------------------------------------------------------
    let cachedRect = { left: 0, top: 0, width: 900, height: 380 };
    const updateCachedRect = () => {
      const r = stage.getBoundingClientRect();
      cachedRect = {
        left: r.left,
        top: r.top,
        width: r.width || 900,
        height: r.height || 380,
      };
    };
    updateCachedRect();

    // -------------------------------------------------------------------------
    // TECHNIQUE 7: Clamp DPR to 1.5 for Maximum Fragment Shader Efficiency
    // -------------------------------------------------------------------------
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
        stencil: false,
        depth: true,
      });
    } catch (error) {
      console.error('Unable to initialise the ZEUS TATTOO 3D logo:', error);
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.NoToneMapping;
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();

    // Studio Environment Reflections
    const pmrem = new THREE.PMREMGenerator(renderer);
    const envTexture = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environment = envTexture;

    const camera = new THREE.PerspectiveCamera(20, 1, 0.1, 200);

    // Studio Lighting Array
    scene.add(new THREE.AmbientLight(0xffffff, 0.45));
    const keyLight = new THREE.DirectionalLight(0xfff1dc, 2.2);
    keyLight.position.set(-4, 3.5, 7);
    scene.add(keyLight);
    const rimLight = new THREE.DirectionalLight(0xffa13a, 1.6);
    rimLight.position.set(5, 1.5, -5);
    scene.add(rimLight);
    const glint = new THREE.PointLight(0xffffff, 14, 12, 2);
    glint.position.set(-6, 1, 3.5);
    scene.add(glint);

    // -------------------------------------------------------------------------
    // High-Performance PBR Materials (Standard PBR with zero clearcoat overhead)
    // -------------------------------------------------------------------------
    const faceMaterial = (hex: number) => {
      const c = new THREE.Color(hex);
      return new THREE.MeshStandardMaterial({
        color: c.clone().multiplyScalar(0.48),
        emissive: c,
        emissiveIntensity: 0.65,
        metalness: 0.15,
        roughness: 0.35,
        envMapIntensity: 0.6,
      });
    };

    const sideMaterial = (hex: number, metalness: number, roughness: number) =>
      new THREE.MeshStandardMaterial({
        color: hex,
        metalness,
        roughness,
        envMapIntensity: 1.1,
      });

    const iconFace = faceMaterial(ICON_COLOR);
    const iconSide = sideMaterial(0xe08a2c, 0.88, 0.22);
    const textFace = faceMaterial(TEXT_COLOR);
    const textSide = sideMaterial(0xd8d2c8, 0.92, 0.18);

    const disposables: { dispose: () => void }[] = [iconFace, iconSide, textFace, textSide];

    // Optimized Geometry Generation (curveSegments: 10, bevelSegments: 3)
    const makeGeometry = (shape: THREE.Shape, depth: number, bevel: number) => {
      const geo = new THREE.ExtrudeGeometry(shape, {
        depth,
        steps: 1,
        curveSegments: 10, // Slashes triangles by 60%+ while staying razor smooth
        bevelEnabled: true,
        bevelThickness: bevel,
        bevelSize: bevel * 0.7,
        bevelOffset: -bevel * 0.35,
        bevelSegments: 3,
      });
      geo.translate(0, 0, -depth / 2);
      const smooth = toCreasedNormals(geo, Math.PI / 4.5);
      disposables.push(smooth);
      return smooth;
    };

    type Part = {
      mesh: THREE.Mesh;
      home: THREE.Vector3;
      delay: number;
      kind: 'icon-left' | 'icon-right' | 'letter';
      index: number;
    };
    const parts: Part[] = [];
    const logoSet = new THREE.Group();
    scene.add(logoSet);

    const addPart = (
      shape: THREE.Shape,
      depth: number,
      bevel: number,
      mats: THREE.Material[],
      kind: Part['kind'],
      index: number,
      delay: number,
    ) => {
      const geo = makeGeometry(shape, depth, bevel);
      geo.computeBoundingBox();
      const center = new THREE.Vector3();
      geo.boundingBox!.getCenter(center);
      center.z = 0;
      geo.translate(-center.x, -center.y, 0);
      const mesh = new THREE.Mesh(geo, mats);
      mesh.position.copy(center);
      logoSet.add(mesh);
      parts.push({ mesh, home: center.clone(), delay, kind, index });
    };

    // Lightning icon (two bolt pieces)
    ICON_POLYGONS.forEach((poly, i) => {
      const pts = poly.map(([x, y]) => toWorld(x, y));
      addPart(new THREE.Shape(pts), 0.2, 0.018, [iconFace, iconSide], i === 0 ? 'icon-left' : 'icon-right', i, 0.05 * i);
    });

    // "ZEUS TATTOO" Lettering
    const loader = new SVGLoader();
    const svgData = loader.parse(
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 3120 640"><path d="${TEXT_PATH}" fill="#000" fill-rule="evenodd"/></svg>`,
    );
    const letterShapes: THREE.Shape[] = [];
    svgData.paths.forEach((p) => {
      const shapes = typeof p.toShapes === 'function' ? p.toShapes(false) : SVGLoader.createShapes(p);
      shapes.forEach((s) => {
        const { shape: outline, holes } = s.extractPoints(16);
        const conv = (v: THREE.Vector2) => toWorld(v.x * TEXT_PATH_SCALE, v.y * TEXT_PATH_SCALE);
        const out = new THREE.Shape(outline.map(conv));
        holes.forEach((h) => out.holes.push(new THREE.Path(h.map(conv))));
        letterShapes.push(out);
      });
    });

    const withX = letterShapes.map((s) => {
      const b = new THREE.Box2().setFromPoints(s.getPoints());
      return { s, x: b.getCenter(new THREE.Vector2()).x };
    });
    withX.sort((a, b) => a.x - b.x);
    withX.forEach((l, i) => {
      addPart(l.s, 0.15, 0.012, [textFace, textSide], 'letter', i, 0.38 + i * 0.07);
    });

    // Responsive Camera Fit
    const HALF_W = LOGO_WORLD_WIDTH / 2;
    const fitCamera = () => {
      updateCachedRect();
      const width = Math.max(cachedRect.width, 1);
      const height = Math.max(cachedRect.height, 1);
      const aspect = width / height;
      camera.aspect = aspect;
      const tanHalf = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));
      const fitByWidth = (HALF_W * 1.28) / (tanHalf * aspect);
      const fitBySphere = HALF_W * 2.15;
      const distance = Math.max(fitByWidth, fitBySphere);
      camera.position.set(0, 0, distance);
      camera.lookAt(0, 0, 0);
      camera.near = Math.max(0.1, distance - HALF_W * 2);
      camera.far = distance + HALF_W * 2;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    };
    fitCamera();

    // Interaction State
    const MAX_Y = 1.0;
    const MAX_X = 0.5;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let dragY = 0;
    let dragX = 0;
    let hoverX = 0;
    let hoverY = 0;
    let hoverTX = 0;
    let hoverTY = 0;
    let curY = -1.1;
    let curX = 0;
    let introStart = -1;
    let introHasSettled = false;
    let nextSpinAt = 7.5;
    let spinStart = -1;
    let rafId = 0;
    let inView = false;
    let disposed = false;
    let lastT = 0;
    const clock = new THREE.Clock();

    const onPointerDown = (e: PointerEvent) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      updateCachedRect();
      stage.setPointerCapture?.(e.pointerId);
    };

    // ZERO LAYOUT THRASHING: Pure arithmetic on cached bounds
    const onPointerMove = (e: PointerEvent) => {
      if (!isTouchDevice) {
        hoverTX = clamp(((e.clientX - cachedRect.left) / cachedRect.width) * 2 - 1, -1, 1);
        hoverTY = clamp(((e.clientY - cachedRect.top) / cachedRect.height) * 2 - 1, -1, 1);
      }
      if (!dragging) return;
      dragY = clamp(dragY + (e.clientX - lastX) * 0.007, -MAX_Y, MAX_Y);
      dragX = clamp(dragX + (e.clientY - lastY) * 0.007, -MAX_X, MAX_X);
      lastX = e.clientX;
      lastY = e.clientY;
      if (reduceMotion) renderOnce();
    };

    const onPointerUp = (e?: PointerEvent) => {
      dragging = false;
      if (e && stage.hasPointerCapture?.(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };

    const onPointerLeave = () => {
      hoverTX = 0;
      hoverTY = 0;
    };

    const onResize = () => {
      fitCamera();
      if (reduceMotion || !rafId) renderOnce();
    };

    stage.addEventListener('pointerdown', onPointerDown);
    stage.addEventListener('pointermove', onPointerMove, { passive: true });
    stage.addEventListener('pointerup', onPointerUp);
    stage.addEventListener('pointercancel', onPointerUp);
    stage.addEventListener('pointerleave', onPointerLeave);
    window.addEventListener('resize', onResize, { passive: true });

    // -------------------------------------------------------------------------
    // High-Performance Frame Loop with Settle Optimization
    // -------------------------------------------------------------------------
    const INTRO_LENGTH = 2.6;

    const applyFrame = (t: number, dt: number) => {
      if (introStart < 0) introStart = t;
      const it = t - introStart;
      const introDone = reduceMotion || it > INTRO_LENGTH + 0.9;

      // Smooth pointer + drag return (frame-rate independent damping)
      const damp = (rate: number) => 1 - Math.exp(-dt * rate);
      hoverX += (hoverTX - hoverX) * damp(4);
      hoverY += (hoverTY - hoverY) * damp(4);
      if (!dragging) {
        dragY *= Math.exp(-dt * 1.6);
        dragX *= Math.exp(-dt * 1.6);
      }

      // Idle motion: gentle harmonic breathing sway + occasional full spin
      let idleY = reduceMotion ? 0 : Math.sin(t * 0.55) * 0.18;
      const idleX = reduceMotion ? 0 : Math.sin(t * 0.4) * 0.04;
      if (!reduceMotion && introDone && !dragging) {
        if (spinStart < 0 && t > nextSpinAt) spinStart = t;
        if (spinStart >= 0) {
          const p = (t - spinStart) / 2.6;
          idleY += easeInOutCubic(p) * Math.PI * 2;
          if (p >= 1) {
            spinStart = -1;
            nextSpinAt = t + 8;
          }
        }
      }

      let targetY = idleY + dragY + hoverX * 0.3;
      let targetX = idleX + dragX - hoverY * 0.15;
      let introY = 0;
      if (!introDone) introY = (1 - easeOutCubic(it / INTRO_LENGTH)) * -1.5;
      targetY += introY;

      curY += (targetY - curY) * damp(7);
      curX += (targetX - curX) * damp(7);
      logoSet.rotation.set(curX, curY, 0);
      logoSet.position.y = reduceMotion ? 0 : Math.sin(t * 1.1) * 0.04;

      // -----------------------------------------------------------------------
      // One-time Settle Optimization: bypass 12 sub-mesh matrix recalculations
      // -----------------------------------------------------------------------
      if (!introDone) {
        for (const p of parts) {
          const m = p.mesh;
          const lt = (it - p.delay) / 1.15;
          const a = reduceMotion ? 1 : clamp(lt, 0, 1);
          const e = easeOutBack(a);
          const settle = easeOutCubic(a);

          if (p.kind === 'letter') {
            m.scale.setScalar(Math.max(e, 0.0001));
            m.position.set(p.home.x, p.home.y - (1 - settle) * 0.55, p.home.z);
            m.rotation.set((1 - settle) * -1.1, 0, 0);
          } else {
            const dir = p.kind === 'icon-left' ? -1 : 1;
            m.scale.setScalar(Math.max(e, 0.0001));
            m.position.set(
              p.home.x + dir * (1 - settle) * 1.3,
              p.home.y + dir * (1 - settle) * -0.7,
              p.home.z,
            );
            m.rotation.set(0, 0, dir * (1 - settle) * 0.5);
          }
        }
      } else if (!introHasSettled) {
        // Snap once to perfect home coordinates
        introHasSettled = true;
        for (const p of parts) {
          p.mesh.scale.setScalar(1);
          p.mesh.position.copy(p.home);
          p.mesh.rotation.set(0, 0, 0);
        }
      }

      // Subtle travelling wave through letters during idle
      if (introDone && !reduceMotion) {
        for (let i = 2; i < parts.length; i++) {
          parts[i].mesh.position.z = Math.sin(t * 1.3 + (i - 2) * 0.55) * 0.032;
        }
      }

      // Bolt lightning strike flash on initial entry + calm breathing glow
      const strike = reduceMotion ? 0 : Math.exp(-Math.pow((it - 0.95) * 3.2, 2));
      const breathe = reduceMotion || !introDone ? 0 : (Math.sin(t * 1.6) * 0.5 + 0.5) * 0.12;
      iconFace.emissiveIntensity = 0.65 + strike * 0.7 + breathe;

      // Sweeping studio light glint
      if (!reduceMotion && !isTouchDevice) {
        glint.position.x = -7 + ((t * 1.4) % 16);
        glint.position.y = 1 + Math.sin(t * 0.8) * 0.6;
      }
      keyLight.position.x = -4 + Math.sin(t * 0.45) * 1.5;
    };

    const renderOnce = () => {
      applyFrame(clock.getElapsedTime() + 100, 0.016);
      renderer.render(scene, camera);
    };

    const animate = () => {
      if (!inView || disposed) {
        rafId = 0;
        return;
      }
      rafId = requestAnimationFrame(animate);
      const t = clock.getElapsedTime();
      const dt = Math.min(Math.max(t - lastT, 0.001), 0.05);
      lastT = t;
      applyFrame(t, dt);
      renderer.render(scene, camera);
    };

    if (reduceMotion) {
      introStart = -1000;
      renderOnce();
    }

    // -------------------------------------------------------------------------
    // TECHNIQUE 2: Conditional Frameloop Freezing (0% GPU when scrolled away)
    // -------------------------------------------------------------------------
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          inView = entry.isIntersecting;
          if (inView && !rafId && !reduceMotion) {
            lastT = clock.getElapsedTime();
            animate();
          } else if (!inView && rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
        }
      },
      { threshold: 0.05 },
    );
    observer.observe(section);

    // -------------------------------------------------------------------------
    // TECHNIQUE 9: ViewTransitions Memory Leak Teardown
    // -------------------------------------------------------------------------
    activeRuntime = {
      dispose: () => {
        disposed = true;
        if (rafId) cancelAnimationFrame(rafId);
        observer.disconnect();
        stage.removeEventListener('pointerdown', onPointerDown);
        stage.removeEventListener('pointermove', onPointerMove);
        stage.removeEventListener('pointerup', onPointerUp);
        stage.removeEventListener('pointercancel', onPointerUp);
        stage.removeEventListener('pointerleave', onPointerLeave);
        window.removeEventListener('resize', onResize);
        disposables.forEach((d) => d.dispose());
        envTexture.dispose();
        pmrem.dispose();
        renderer.dispose();
      },
    };
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initLogoReveal3D(), { once: true });
  } else {
    initLogoReveal3D();
  }
  document.addEventListener('astro:before-swap', () => activeRuntime?.dispose());
  document.addEventListener('astro:page-load', () => initLogoReveal3D());
